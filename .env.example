TIPPEKJELLEREN_PASSCODE=Norge
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PLAYER_IDS=alf
CRON_SECRET=replace-with-a-long-random-cron-secret

# Vercel Blob is the default durable storage path on Vercel.
BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token

# Optional Supabase/Postgres connection string. Takes priority over Blob when set.
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require

# Optional server-side API-Football fallback for faster live/prematch/postmatch data.
# Do not expose this as NEXT_PUBLIC. The app never calls odds/predictions endpoints.
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=
API_FOOTBALL_SEASON=2026

# Optional server-side odds feed for kampbonus autofill.
# The app ignores odds players that do not match synced World Cup squad players.
BONUS_ODDS_URL=https://example.com/tippekjelleren-bonus-odds.json
