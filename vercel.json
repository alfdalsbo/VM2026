{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "agent/**": false,
      "automation/**": false,
      "chatgpt/**": false,
      "codex/**": false,
      "dependabot/**": false,
      "data/**": false,
      "docs/**": false,
      "feature/**": false,
      "fix/**": false,
      "chore/**": false,
      "refactor/**": false,
      "research/**": false,
      "test/**": false,
      "work/**": false,
      "architecture/**": false,
      "architecture-*": false
    }
  },
  "ignoreCommand": "git rev-parse --verify HEAD^ >/dev/null 2>&1 || exit 1; git diff --quiet HEAD^ HEAD -- . ':(exclude)*.md' ':(exclude)**/*.md' ':(exclude)docs/**' ':(exclude).github/**'; test $? -eq 0",
  "crons": [
    {
      "path": "/api/sync/world-cup",
      "schedule": "11 4 * 6,7 *"
    }
  ]
}
